# ==============================================================================
# LEAF Project - .gitignore
# ==============================================================================

# Discussion artifacts with AI agents
Discussion-artifacts/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Python virtual environment (managed by uv)
.venv/
env/
venv/

# Python packaging & build outputs
build/
dist/
*.egg-info/
*.egg

# Testing, coverage & linting caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Temporary compilation & runner artifacts (C++, Java, intermediate executables)
artifacts/*
!artifacts/README.md
*.o
*.obj
*.exe
*.class
*.jar
*.pdb

# Experiments, logs, local databases & large downloaded data
*.log
*.sqlite3
*.sqlite3-journal
*.db
results/experiments/
results/analysis/
results/figures/
!results/README.md
data/datasets/
data/cache/
!data/README.md

# Secrets, API tokens & local environment files
.env
.env.*
*.key
*.pem

# IDEs & Editor configurations
.vscode/
.idea/
*.swp
*~

# Operating system files
.DS_Store
Thumbs.db

# Explicitly tracked project configuration (do not ignore)
!.python-version
!uv.lock
!pyproject.toml
